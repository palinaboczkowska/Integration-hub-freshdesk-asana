{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Freshdesk": {
    "BaseUrl": "https://pbwebstudio-help.freshdesk.com",
    "ApiKey": "YOUR_FRESHDESK_API_KEY",
    "SystemEmail": "YOUR_FRESHDESK_AGENT_EMAIL"
  },
  "Asana": {
    "BaseUrl": "https://app.asana.com/api/1.0",
    "Token": "YOUR_ASANA_TOKEN",
    "WorkspaceId": "YOUR_ASANA_WORKSPACE_ID",
    "ProjectId": "YOUR_ASANA_PROJECT_ID"
  },
  "IntegrationSettings": {
    "Name": "Integration Hub",
    "DefaultTimeoutSeconds": 30,
    "Environment": "Production"
  },
  "AllowedHosts": "*"
}
